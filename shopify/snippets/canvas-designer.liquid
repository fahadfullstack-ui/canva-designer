        </div>

                <!-- Unsaved Changes Modal -->
                <div id="unsaved-modal" class="hidden fixed inset-0 z-[9999999] flex items-center justify-center p-4"
                    style="backdrop-filter: blur(8px); background: rgba(0,0,0,0.5);">
                    <div id="unsaved-modal-backdrop" class="absolute inset-0"></div>
                    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden flex flex-col">
                        <div class="p-4 border-b border-slate-100 flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-yellow-100 flex items-center justify-center">
                                <i data-lucide="alert-triangle" class="size-4 text-yellow-600"></i>
                            </div>
                            <h3 class="text-lg font-bold text-slate-900">Ungespeicherte Änderungen</h3>
                        </div>
                        <div class="p-4 text-slate-600 text-sm">
                            Du hast Änderungen vorgenommen. Möchtest du sie speichern oder verwerfen?
                        </div>
                        <div class="p-4 border-t border-slate-100 flex justify-end gap-2">
                            <button id="unsaved-cancel" class="px-3 py-2 text-slate-600 hover:text-slate-800 rounded-lg">Abbrechen</button>
                            <button id="unsaved-discard" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-lg">Verwerfen</button>
                            <button id="unsaved-save" class="px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg">Speichern</button>
                        </div>
                    </div>
                </div>
    </div>
</div>

